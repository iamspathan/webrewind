# Port the Express server listens on
PORT=3200

# Origin allowed by CORS (must match the client's origin)
CLIENT_ORIGIN=http://localhost:5173

# Public URL the server uses when constructing /screenshots and
# /screenshots/events/<id> URLs in JSON responses. Image URLs are built
# from MINIO_PUBLIC_URL (below), not this one.
PUBLIC_BASE_URL=http://localhost:3200

# --- MinIO / object storage ---
# Internal endpoint the server uses to PUT/DELETE objects. In docker
# compose this is http://minio:9000; standalone dev typically uses
# http://localhost:9000.
MINIO_ENDPOINT=http://localhost:9000

# Public endpoint the BROWSER uses to GET images. Defaults to
# MINIO_ENDPOINT when not set. In prod, point this at the public hostname
# you've exposed MinIO (or S3) on — the image URLs baked into responses
# and cached manifests use this value.
# MINIO_PUBLIC_URL=http://localhost:9000

MINIO_BUCKET=webrewind
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Disable the result cache entirely (cache manifests are stored in
# MinIO under _cache/<sha>.json).
# CACHE_ENABLED=false

# --- Corporate TLS (only needed on networks with SSL inspection/MITM) ---
# If your network intercepts HTTPS (Zscaler, Palo Alto, corporate proxy),
# axios will fail with "self-signed certificate in certificate chain".
#
# Preferred fix: export your organisation's root CA (ask IT or via macOS
# Keychain Access → System Roots → File → Export Items → .pem) and set:
# EXTRA_CA_CERT_PATH=/absolute/path/to/corp-root-ca.pem
#
# Escape hatch (DEV ONLY — never ship this): disable cert verification.
# INSECURE_TLS=true

# --- Capture tuning ---
# Parallel captures per job. 1 = sequential (old behaviour); 4 is usually
# the sweet spot on an 8-core laptop. Higher = faster but more RAM per job
# (~120MB per Chromium page).
# CAPTURE_CONCURRENCY=4

# Page navigation timeout in ms. Archived pages sometimes never finish
# loading dead third-party resources; 25s is generous without being silly.
# CAPTURE_NAV_TIMEOUT_MS=25000

# After DOMContentLoaded, wait for this many ms of quiet network before
# screenshotting. If the page never goes quiet we give up after
# CAPTURE_NETWORK_IDLE_TIMEOUT_MS and screenshot anyway.
# CAPTURE_NETWORK_IDLE_MS=400
# CAPTURE_NETWORK_IDLE_TIMEOUT_MS=5000

# --- AI caption summaries (optional) ---
# NVIDIA-hosted Gemma 3n vision endpoint. When NVIDIA_API_KEY is unset the
# /summaries endpoint returns 503 and cards render without captions.
# Get a key at https://build.nvidia.com/ — never commit the real value.
# NVIDIA_API_KEY=nvapi-your-key-here

# Override the model slug (default: google/gemma-3n-e4b-it).
# SUMMARY_MODEL=google/gemma-3n-e4b-it

# Max tokens per caption (default 220 — ~2 sentences).
# SUMMARY_MAX_TOKENS=220

# Override the caption prompt if the default tone needs adjusting.
# SUMMARY_PROMPT="This is an archived screenshot of a website from the Wayback Machine. In 2 concise sentences, describe the visual design, dominant colors, and notable UI elements (hero, navigation, imagery) — like a historian captioning a museum exhibit. Do not mention the Wayback banner if present."

# Upstream timeout for the NVIDIA call (default 30_000ms).
# NVIDIA_TIMEOUT_MS=30000

# Per-IP rate limit on /summaries (default 60 req/min).
# SUMMARY_RATE_LIMIT_MAX=60
