# Base URL the client uses for API calls.
# Leave empty in dev to use same-origin + Vite proxy (recommended).
# In prod set to your API host, e.g. https://api.webrewind.example.com
VITE_API_BASE_URL=

# Dev-only: Vite proxy target for /screenshots, /health, /docs.
# Defaults to http://localhost:3200 if unset. Image URLs are NOT
# proxied — they point directly at MinIO (see server's MINIO_PUBLIC_URL).
VITE_API_PROXY_TARGET=http://localhost:3200

# MinIO URL the browser uses to load preview/demo images directly.
# Shape: <MINIO_PUBLIC_URL>/<bucket>. Defaults to the local compose stack.
# VITE_IMAGES_BASE_URL=http://localhost:9000/webrewind
